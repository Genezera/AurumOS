# Modo padrão: coleta e contabiliza cotações sem enviar ordem.
AURUMOS_EXECUTION_MODE=shadow

# Preencha apenas para AURUMOS_EXECUTION_MODE=demo.
# Crie as chaves em uma conta Bybit Demo dedicada e sem posições manuais.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Opcionais para os sensores observacionais já existentes.
AURUMOS_ETH_RPC_URL=
OLLAMA_URL=http://127.0.0.1:11434
